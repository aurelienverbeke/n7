#!/bin/bash
ip link set dev eth0 up
ip link set dev eth1 up
ip addr add 201.201.201.3/27 dev eth0
ip addr add 201.201.201.33/27 dev eth1
echo 1 > /proc/sys/net/ipv4/ip_forward
ip route add 201.201.201.64/27 via 201.201.201.34
ip route add 201.201.201.96/27 via 201.201.201.35
ip route add 201.201.201.128/27 via 201.201.201.34
ip route add 201.201.201.160/27 via 201.201.201.34
ip route add 201.201.201.192/27 via 201.201.201.35
